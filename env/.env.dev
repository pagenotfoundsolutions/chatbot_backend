# Copy this file to .env and fill in real values:  cp .env.example .env

# ===== Project metadata =====
PROJECT_NAME=chatbot_backend
NAME=chatbot
DESCRIPTION=Add your description here
VERSION=0.0.1

# ===== Database =====
DATABASE_URL=postgresql+psycopg://admin:admin@db:5432/chatbot

# ===== Storage paths =====
UPLOAD_DIR=storage/uploads




# ===== Auth =====
AUTH_JWT_SECRET_KEY=a_very_secret_key_from_env_that_is_long_enough
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=12600
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=30

# ===== Docker Compose Settings =====
APP_PORT=18100
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=chatbot
POSTGRES_PORT=18110
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=18120
