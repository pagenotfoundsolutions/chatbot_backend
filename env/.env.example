# Copy this file and fill in real secrets:
#   cp env/.env.example env/.env

# ===== Runtime =====
# Production defaults:
APP_ENV=prod
APP_RELOAD=false
APP_CONTAINER_NAME=chatbot_app
APP_RUNTIME_MOUNT=app_uploads:/app/storage/uploads
APP_UPLOAD_VOLUME=chatbot_app_uploads

# For development change only these values:
# APP_ENV=dev
# APP_RELOAD=true
# POSTGRES_DB=chatbot_dev
# APP_RUNTIME_MOUNT=../:/app

# ===== Project metadata =====
PROJECT_NAME=chatbot
DESCRIPTION=PDF RAG chatbot backend
VERSION=0.0.1
APP_PORT=18100

# ===== Storage =====
UPLOAD_DIR=storage/uploads

# ===== Authentication =====
AUTH_JWT_SECRET_KEY=replace-with-a-long-random-secret
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== Shared PostgreSQL =====
POSTGRES_USER=chatbot_db
POSTGRES_PASSWORD=replace-with-the-shared-chatbot-password
POSTGRES_DB=chatbot_db
# Compose overrides DATABASE_URL with the shared-postgres hostname. This value
# also lets application commands load settings outside Compose when DNS exists.
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@shared-postgres:5432/${POSTGRES_DB}

# ===== SMTP =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=replace-with-an-app-password
SMTP_USE_TLS=true

# ===== LLM API keys =====
NVIDIA_API_KEY=
