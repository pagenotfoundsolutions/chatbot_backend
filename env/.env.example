# Copy this file to .env and fill in real values:  cp .env.example .env

# ===== Project metadata =====
NAME=chatbot
DESCRIPTION=Add your description here
VERSION=0.0.1

# ===== Database =====
DATABASE_URL=postgresql+psycopg://admin:admin@db:5432/chatbot

# ===== Storage paths =====
UPLOAD_DIR=storage/uploads


# ===== Auth =====
AUTH_JWT_SECRET_KEY=a_very_secret_key_from_env_that_is_long_enought_jwt_key
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== Docker Compose Settings =====
APP_PORT=8000
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=chatbot
POSTGRES_PORT=5432
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
