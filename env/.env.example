# Copy this file to .env and fill in real values:  cp .env.example .env

# ===== Project metadata =====
NAME=chatbot
DESCRIPTION=Add your description here
VERSION=0.0.1

# ===== Database =====
DATABASE_URL=postgresql+psycopg://admin:admin@db:5432/chatbot

# ===== Storage paths =====
UPLOAD_DIR=storage/uploads

# ===== LLM (chat module) =====
# Provider: echo | anthropic | openai | ollama | huggingface | nvidia
# `echo` needs no keys/deps and works out of the box.
LLM_PROVIDER=echo
# Optional — overrides the per-provider default model:
#   anthropic -> claude-sonnet-4-6 | openai -> gpt-4o-mini
#   ollama    -> llama3.1          | huggingface -> HuggingFaceH4/zephyr-7b-beta | nvidia -> nvidia/nemotron-3-ultra-550b-a55b
# LLM_MODEL=meta/llama-3.1-70b-instruct
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
LLM_SYSTEM_PROMPT=You are a helpful assistant.
LLM_BASE_URL=http://localhost:11434

# Provider API keys (set the one matching LLM_PROVIDER):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
HUGGINGFACEHUB_API_TOKEN=
NVIDIA_API_KEY=nvapi-...

# ===== Auth =====
AUTH_JWT_SECRET_KEY=a_very_secret_key_from_env_that_is_long_enought_jwt_key
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== Docker Compose Settings =====
APP_PORT=8000
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=chatbot
POSTGRES_PORT=5432
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
